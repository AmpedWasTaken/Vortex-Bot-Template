# Dashboard environment (copy to `.env.local`)

# Comma-separated auth modes: password | discord (default: password)
DASHBOARD_AUTH_MODES=password

# Password gate (>= 8 characters) when password mode is enabled
DASHBOARD_PASSWORD=change-me-please

# Signs dashboard session cookies and OAuth state (>= 32 characters)
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret-string-here

# --- Discord OAuth (when DASHBOARD_AUTH_MODES includes discord) ---
# Use the same Discord application as the bot. Add redirect in Developer Portal → OAuth2:
#   http://localhost:3100/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3100/api/auth/discord/callback
# Space-separated Discord scopes. Use "identify guilds" for DASHBOARD_DISCORD_REQUIRE_BOT_GUILD_OWNER.
DISCORD_OAUTH_SCOPES=identify

# Optional access control (evaluated after OAuth, before session cookie is set)
# DASHBOARD_DISCORD_USER_IDS=123456789012345678,987654321098765432
# DISCORD_BOT_TOKEN=                          # same bot token as worker; used for owner/role REST checks
# DASHBOARD_DISCORD_REQUIRE_BOT_GUILD_OWNER=true
# DASHBOARD_ACCESS_GUILD_ID=
# DASHBOARD_ACCESS_ROLE_IDS=                  # comma-separated role snowflakes in that guild

NODE_ENV=development

# Control plane Postgres (Neon / RDS / local). Enables durable telemetry, Stripe idempotency, operator keys.
CONTROL_PLANE_DATABASE_URL=

# Optional: increase serverless pool size (default 8)
# CONTROL_PLANE_PG_POOL=8

# Bot → dashboard ingest (must match worker BOT_INGEST_SECRET)
BOT_INGEST_SECRET=

# Display-only: mirror worker PREMIUM_SKU_IDS for the billing console (comma-separated)
DISCORD_PREMIUM_SKU_IDS=

# Optional Stripe (see /dashboard/billing + /api/webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CUSTOMER_ID=
STRIPE_SUCCESS_URL=http://localhost:3100/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3100/dashboard/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3100/dashboard/billing
